#!/usr/bin/env python3
"""manifest — read manifest.toml, the one list of what agent-tools offers.

  scripts/manifest skills           name<TAB>dest roots, for install.sh to link
  scripts/manifest readme [--check] write the README's tool tables (--check: exit 1 if stale)
  scripts/manifest check            exit 1 if the manifest drifted from skills/ or agt/agt
"""
import os
import re
import sys

try:
    import tomllib
except ModuleNotFoundError:
    sys.exit("manifest: needs Python 3.11+ (tomllib); try: brew install python")

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
README = os.path.join(ROOT, "README.md")
START, END = "<!-- tools:start (generated by scripts/manifest readme) -->", "<!-- tools:end -->"


def load():
    with open(os.path.join(ROOT, "manifest.toml"), "rb") as f:
        return tomllib.load(f)


def cmd_skills(m):
    for name, sk in m["skill"].items():
        roots = []
        for engine in sk["engines"]:
            root = os.path.expanduser(m["engines"][engine])
            if engine == "hermes" and not os.path.isdir(root):
                continue
            roots.append(root)
        if roots:
            print("\t".join([name] + roots))


def tables(m):
    out = []
    for gid, g in m["group"].items():
        out += [f"### {g['title']} — {g['tagline']}", "",
                "| Tool | What it does | CLI | Skill | Works in |", "|---|---|---|---|---|"]
        for t in m["tool"]:
            if t["group"] != gid:
                continue
            cli = ", ".join(f"`{c}`" for c in t.get("cli", [])) or "—"
            skills = ", ".join(f"`{s}`" for s in t.get("skills", [])) or "—"
            out.append(f"| {t['name']} | {t['summary']} | {cli} | {skills} | {t['works_in']} |")
        out.append("")
    return "\n".join(out)


def cmd_readme(m, check):
    with open(README) as f:
        text = f.read()
    if START not in text or END not in text:
        sys.exit(f"manifest: README.md is missing the {START} … {END} markers")
    head, rest = text.split(START, 1)
    _, tail = rest.split(END, 1)
    new = head + START + "\n\n" + tables(m) + "\n" + END + tail
    if new == text:
        return 0
    if check:
        print("README.md tool tables are stale: run scripts/manifest readme", file=sys.stderr)
        return 1
    with open(README, "w") as f:
        f.write(new)
    print("README.md tool tables rewritten")
    return 0


def cmd_check(m):
    errors = []
    groups, skills, engines = set(m["group"]), set(m["skill"]), set(m["engines"])
    used = set()
    for t in m["tool"]:
        if t["group"] not in groups:
            errors.append(f"tool {t['name']}: unknown group {t['group']}")
        for s in t.get("skills", []):
            used.add(s)
            if s not in skills:
                errors.append(f"tool {t['name']}: skill {s} has no [skill.{s}]")
    for s in sorted(skills - used):
        errors.append(f"[skill.{s}] is not offered by any [[tool]]")
    for s, sk in m["skill"].items():
        for e in sk["engines"]:
            if e not in engines:
                errors.append(f"[skill.{s}]: unknown engine {e}")

    on_disk = {d for d in os.listdir(os.path.join(ROOT, "skills"))
               if os.path.isfile(os.path.join(ROOT, "skills", d, "SKILL.md"))}
    for s in sorted(on_disk - skills):
        errors.append(f"skills/{s} is not in manifest.toml")
    for s in sorted(skills - on_disk):
        errors.append(f"[skill.{s}] has no skills/{s}/SKILL.md")

    with open(os.path.join(ROOT, "agt", "agt")) as f:
        agt = f.read()
    top = set(re.findall(r"^  ([a-z][a-z-]*)\)$", agt, re.M))
    subs = set(re.findall(r"^      ([a-z][a-z-]*)\) exec", agt, re.M))
    helped = set(re.findall(r"^  agt ([a-z][a-z-]*)", agt, re.M))
    offered = set()
    for t in m["tool"]:
        for c in t.get("cli", []):
            words = c.split()
            if words[0] != "agt" or len(words) < 2:
                errors.append(f"tool {t['name']}: cli {c!r} is not an agt command")
                continue
            offered.add(words[1])
            if words[1] not in top:
                errors.append(f"tool {t['name']}: agt/agt has no '{words[1]}' command")
            if len(words) > 2 and words[2] not in subs:
                errors.append(f"tool {t['name']}: agt/agt has no '{words[1]} {words[2]}' subcommand")
    for c in sorted(top - offered):
        errors.append(f"agt {c} is not offered by any [[tool]]")
    for c in sorted(top - helped):
        errors.append(f"agt {c} is missing from agt help")

    for e in errors:
        print("manifest: " + e, file=sys.stderr)
    return 1 if errors else 0


def main(argv):
    m = load()
    if argv[:1] == ["skills"]:
        cmd_skills(m)
        return 0
    if argv[:1] == ["readme"]:
        return cmd_readme(m, "--check" in argv)
    if argv[:1] == ["check"]:
        return cmd_check(m)
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

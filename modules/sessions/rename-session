#!/usr/bin/env python3
"""
rename-session - Rename a Claude Code session by setting its custom title.

Searches across all projects for the session ID and appends a custom-title record
to the JSONL transcript (same mechanism as Ctrl+R rename and rename-claude-sessions).

Usage:
    rename-session <session-id> <title>
    rename-session <session-id> word1 word2 ...   # words joined into title

Examples:
    rename-session abc123ef "Review PR #456: Fix auth bug"
    rename-session abc123ef Review PR 456 Fix auth bug
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

CLAUDE_PROJECTS_DIR = Path.home() / ".claude" / "projects"


def find_session_file(session_id: str) -> Path | None:
    if not CLAUDE_PROJECTS_DIR.is_dir():
        return None
    for project_dir in CLAUDE_PROJECTS_DIR.iterdir():
        if not project_dir.is_dir():
            continue
        candidate = project_dir / f"{session_id}.jsonl"
        if candidate.exists():
            return candidate
    return None


def set_custom_title(filepath: Path, session_id: str, title: str) -> bool:
    record = {
        "type": "custom-title",
        "customTitle": title,
        "sessionId": session_id,
    }
    try:
        with open(filepath, "a") as f:
            f.write(json.dumps(record, ensure_ascii=False) + "\n")
        return True
    except OSError as e:
        print(f"ERROR writing {filepath}: {e}", file=sys.stderr)
        return False


def main():
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help"):
        print("Usage: rename-session <session-id> <title>", file=sys.stderr)
        sys.exit(0 if args else 1)

    if len(args) < 2:
        print("Usage: rename-session <session-id> <title>", file=sys.stderr)
        sys.exit(1)

    session_id = args[0]
    title = " ".join(args[1:])

    filepath = find_session_file(session_id)
    if not filepath:
        print(f"ERROR: session {session_id!r} not found across all projects", file=sys.stderr)
        sys.exit(1)

    if set_custom_title(filepath, session_id, title):
        print(f"Renamed: {title}")
    else:
        sys.exit(1)


if __name__ == "__main__":
    main()
